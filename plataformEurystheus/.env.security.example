# ==============================================================================
# EURYSTHEUS AI SECURITY CONFIGURATION
# ==============================================================================
# This file contains security-related environment variables for the 
# Eurystheus AI SaaS platform. Copy these settings to your .env file
# and adjust the values according to your security requirements.

# ------------------------------------------------------------------------------
# GENERAL SECURITY SETTINGS
# ------------------------------------------------------------------------------
SECURITY_MONITORING_ENABLED=true

# ------------------------------------------------------------------------------
# ALERT THRESHOLDS
# ------------------------------------------------------------------------------
# Adjust these values based on your normal traffic patterns
SECURITY_ATTACKS_PER_MINUTE=10
SECURITY_FAILED_LOGINS_PER_MINUTE=20
SECURITY_BLOCKED_IPS_THRESHOLD=50
SECURITY_SQL_INJECTION_PER_MINUTE=5
SECURITY_XSS_ATTEMPTS_PER_MINUTE=5
SECURITY_DOS_ATTACKS_PER_MINUTE=30
SECURITY_BRUTE_FORCE_PER_MINUTE=15
SECURITY_CREDENTIAL_STUFFING_PER_MINUTE=10
SECURITY_SESSION_HIJACKING_PER_MINUTE=3
SECURITY_PHISHING_ATTEMPTS_PER_MINUTE=2
SECURITY_API_VIOLATIONS_PER_MINUTE=8
SECURITY_MITM_ATTACKS_PER_MINUTE=2
SECURITY_DESERIALIZATION_PER_MINUTE=3
SECURITY_GEOGRAPHIC_ANOMALY=10
SECURITY_COORDINATED_ATTACK=5

# System health thresholds
SECURITY_DB_RESPONSE_TIME=1000
SECURITY_MIDDLEWARE_FAILURE_RATE=0.05

# ------------------------------------------------------------------------------
# NOTIFICATION SETTINGS
# ------------------------------------------------------------------------------
# Email notifications
SECURITY_EMAIL_NOTIFICATIONS=true
SECURITY_EMAIL_RECIPIENTS="admin@eurystheusai.com,security@eurystheusai.com"

# Slack notifications (optional)
SECURITY_SLACK_NOTIFICATIONS=false
SECURITY_SLACK_WEBHOOK=""
SECURITY_SLACK_CHANNEL="#security-alerts"

# SMS notifications (optional)
SECURITY_SMS_NOTIFICATIONS=false
SECURITY_SMS_SERVICE="twilio"
SECURITY_SMS_RECIPIENTS=""

# Alert retention
SECURITY_ALERT_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# GEOGRAPHIC SECURITY
# ------------------------------------------------------------------------------
SECURITY_GEOGRAPHIC_MONITORING=true
SECURITY_BLOCKED_COUNTRIES=""
SECURITY_ALLOWED_COUNTRIES=""
SECURITY_VPN_DETECTION=true
SECURITY_TOR_DETECTION=true

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
SECURITY_GLOBAL_RATE_LIMIT=1000
SECURITY_PER_IP_RATE_LIMIT=60
SECURITY_LOGIN_RATE_LIMIT=5
SECURITY_API_RATE_LIMIT=100
SECURITY_PASSWORD_RESET_LIMIT=3

# ------------------------------------------------------------------------------
# AUTOMATED RESPONSES
# ------------------------------------------------------------------------------
SECURITY_AUTOMATED_RESPONSES=true
SECURITY_AUTO_BLOCK_IPS=true
SECURITY_AUTO_BLOCK_DURATION=3600
SECURITY_ESCALATE_TO_MANUAL=true

# ------------------------------------------------------------------------------
# EXTERNAL INTEGRATIONS (Optional)
# ------------------------------------------------------------------------------
# Threat Intelligence
SECURITY_THREAT_INTEL=false
VIRUSTOTAL_API_KEY=""
SHODAN_API_KEY=""

# SIEM Integration
SECURITY_SIEM_INTEGRATION=false
SIEM_ENDPOINT=""
SIEM_API_KEY=""

# Vulnerability Scanners
SECURITY_VULN_SCANNERS=true
SNYK_ENABLED=false
SNYK_API_KEY=""

# ------------------------------------------------------------------------------
# TWILIO SMS CONFIGURATION (If SMS notifications enabled)
# ------------------------------------------------------------------------------
TWILIO_SID=""
TWILIO_TOKEN=""
TWILIO_FROM=""

# ------------------------------------------------------------------------------
# ADDITIONAL SECURITY HEADERS
# ------------------------------------------------------------------------------
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY="default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'"
FEATURE_POLICY="geolocation 'none'; microphone 'none'; camera 'none'"
PERMISSIONS_POLICY="geolocation=(), microphone=(), camera=()"

# ------------------------------------------------------------------------------
# SESSION SECURITY
# ------------------------------------------------------------------------------
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE="strict"

# ------------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
LOG_SECURITY_EVENTS=true
LOG_LEVEL_SECURITY="warning"
LOG_CHANNEL_SECURITY="security"

# ------------------------------------------------------------------------------
# BACKUP AND RECOVERY
# ------------------------------------------------------------------------------
BACKUP_ENCRYPTION_ENABLED=true
BACKUP_RETENTION_DAYS=30
AUTOMATED_BACKUP_FREQUENCY="daily"

# ------------------------------------------------------------------------------
# DEVELOPMENT/TESTING SETTINGS
# ------------------------------------------------------------------------------
# Set to false in production
SECURITY_DEBUG_MODE=false
SECURITY_TEST_MODE=false
